# Public production URL, without a trailing slash
PUBLIC_SITE_URL=https://bescheiben.com.br

# Cloudflare Turnstile
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Durable rate limiting (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_HASH_SECRET=

# Resend — CONTACT_FROM_EMAIL must use a verified sending domain
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Bescheiben <contato@bescheiben.com.br>
