---
import { parseMasterMarkdown } from '../utils/master-markdown';
import type { ContentSection, CallToAction } from '../content/site-content';
import CopyBlocks from './CopyBlocks.astro';
interface Props { section: ContentSection; ctas: readonly CallToAction[]; }
const { section, ctas } = Astro.props;
const blocks = parseMasterMarkdown(section.body);
const heading = blocks.find(block => block.type === 'heading');
const title = heading && 'text' in heading ? heading.text : section.heading;
const symptoms = blocks.filter(block => block.type === 'paragraph' && 'text' in block && block.text.startsWith('“'));
const rest = blocks.filter(block => block !== heading && block.type !== 'eyebrow' && !symptoms.includes(block));
const diagnosisIndex = rest.findIndex(block => block.type === 'subheading');
const diagnosisHeading = diagnosisIndex >= 0 ? rest[diagnosisIndex] : undefined;
const bridge = diagnosisIndex >= 0 ? rest.slice(0, diagnosisIndex) : rest;
const explanation = diagnosisIndex >= 0 ? rest.slice(diagnosisIndex + 1) : [];
const conclusionIndex = explanation.findIndex(block => block.type === 'statement');
const evidence = conclusionIndex >= 0 ? explanation.slice(0, conclusionIndex) : explanation;
const conclusion = conclusionIndex >= 0 ? explanation.slice(conclusionIndex) : [];
---
<section id={section.id} class="symptom-story" data-copy-section={section.id}>
  <div class="container">
    <div class="symptom-layout">
      <div class="symptom-anchor">
        <span class="symptom-anchor__eyebrow">01 / Antes da solução</span>
        <h2>{title}</h2>
        <div class="symptom-anchor__visual" aria-hidden="true">
          <svg viewBox="0 0 410 250" fill="none">
            <ellipse cx="205" cy="125" rx="166" ry="72" transform="rotate(-25 205 125)" stroke="currentColor" stroke-opacity=".3"/>
            <ellipse cx="205" cy="125" rx="166" ry="72" transform="rotate(38 205 125)" stroke="currentColor" stroke-opacity=".48"/>
            <circle cx="205" cy="125" r="54" stroke="currentColor" stroke-opacity=".22"/>
            <circle cx="205" cy="125" r="34" fill="#f8f3ff" stroke="#a16cdb"/>
            <path d="M190 132h30m-22-12h22m-31 24h18" stroke="#7440b6" stroke-width="3" stroke-linecap="round"/>
            <circle cx="45" cy="164" r="5" fill="#8d53cd"/><circle cx="365" cy="94" r="3" fill="#8d53cd"/>
          </svg>
        </div>
      </div>
      <div class="symptom-flow">
        <div class="symptom-layers">
          <svg class="symptom-thread" viewBox="0 0 500 540" preserveAspectRatio="none" fill="none" aria-hidden="true"><path d="M458 0c0 70-412 80-412 160s412 70 412 150S46 405 46 470s212 50 212 70" stroke="currentColor"/><circle cx="458" cy="0" r="5" fill="currentColor"/><circle cx="46" cy="470" r="5" fill="currentColor"/></svg>
          {symptoms.map(block => (
            <div class="symptom-layer">
              <p>{'text' in block ? block.text : ''}</p>
              <span class="symptom-dot" aria-hidden="true"></span>
            </div>
          ))}
        </div>
        <div class="symptom-bridge"><CopyBlocks blocks={bridge} ctas={ctas}/></div>
      </div>
    </div>
    <div class="symptom-resolution">
      {diagnosisHeading && 'text' in diagnosisHeading && <h3>{diagnosisHeading.text}</h3>}
      <div class="symptom-evidence">
        {evidence.map(block => <div class="symptom-proof"><span aria-hidden="true"></span><CopyBlocks blocks={[block]} ctas={ctas}/></div>)}
      </div>
      <div class="symptom-conclusion"><CopyBlocks blocks={conclusion} ctas={ctas}/></div>
    </div>
  </div>
</section>
<style>
.symptom-story{padding-block:clamp(4rem,7vw,7rem);background:radial-gradient(ellipse at 8% 10%,#eee5fc,transparent 38%),#fcfbfe;overflow:clip}
.symptom-layout{display:block}
.symptom-anchor{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.8fr);align-items:center;gap:clamp(1.5rem,5vw,5rem)}
.symptom-anchor__eyebrow{grid-column:1/-1;color:#7243a9;font-size:.7rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase}
.symptom-anchor h2{max-width:15ch;margin:0;font-size:clamp(2.8rem,5vw,5.3rem);line-height:1.03;letter-spacing:-.055em;color:#21103d}
.symptom-anchor__visual{width:100%;max-width:31rem;margin-inline:auto;color:#8b55c4}
.symptom-anchor__visual svg{display:block;width:100%;filter:drop-shadow(0 0 22px #a96beb28)}
.symptom-flow{margin-top:clamp(2rem,4vw,4rem)}
.symptom-layers{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem}
.symptom-thread{display:none}
.symptom-layer{display:flex;align-items:center;justify-content:space-between;gap:1rem;min-height:7rem;padding:1.3rem 1.5rem;border:1px solid #c7b1e177;border-radius:.3rem;background:linear-gradient(112deg,#fff,#faf7ff);box-shadow:0 8px 22px #59397b09}
.symptom-layer p{max-width:31ch;margin:0;font-family:var(--font-display);font-size:clamp(1.2rem,1.85vw,1.8rem);line-height:1.25;letter-spacing:-.035em;color:#3c205d}
.symptom-dot{width:8px;height:8px;border-radius:50%;flex:none;background:#8d53cd;box-shadow:0 0 0 6px #a97adc20}
.symptom-bridge{max-width:62ch;padding-top:1.5rem}
.symptom-bridge :global(p){font-size:1rem;line-height:1.65;color:#726180;margin:0 0 .5rem}
.symptom-resolution{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:2rem clamp(2rem,5vw,5rem);margin-top:clamp(2.5rem,5vw,5rem);padding-top:clamp(2.5rem,5vw,5rem);border-top:1px solid #c4afd642}
.symptom-resolution>h3{font-family:var(--font-display);font-size:clamp(2rem,3.2vw,3.6rem);font-weight:400;letter-spacing:-.05em;line-height:1.12;color:#482768;max-width:15ch;margin:0}
.symptom-evidence{display:grid;gap:0}
.symptom-proof{display:flex;align-items:baseline;gap:1rem;padding:.85rem 0;border-bottom:1px solid #c9b7da42}
.symptom-proof:first-child{padding-top:0}.symptom-proof:last-child{border-bottom:0}
.symptom-proof>span{width:5px;height:5px;rotate:45deg;flex:none;background:#a68abe}
.symptom-proof :global(p){color:#685574;font-size:.93rem;line-height:1.6;margin:0}
.symptom-conclusion{grid-column:1/-1;display:flex;align-items:center;justify-content:space-between;gap:2rem;margin-top:.5rem;padding-top:1.5rem;border-top:1px solid #c4afd642}
.symptom-conclusion :global(.copy-statement){font-family:var(--font-display);font-size:clamp(1.6rem,2.7vw,2.7rem);font-weight:400;letter-spacing:-.045em;line-height:1.2;color:#4b2774;max-width:33ch;margin:0}
.symptom-conclusion :global(.copy-action){flex:none}
@media(max-width:48rem){.symptom-anchor{grid-template-columns:1fr;gap:1rem}.symptom-anchor__eyebrow{grid-column:1}.symptom-anchor h2{max-width:22ch}.symptom-anchor__visual{max-width:19rem}.symptom-layers{grid-template-columns:1fr}.symptom-layer{min-height:5rem}.symptom-resolution{grid-template-columns:1fr;gap:1.5rem}.symptom-resolution>h3{max-width:20ch}.symptom-conclusion{display:block}.symptom-conclusion :global(.copy-action){margin-top:1.25rem}}
@media(max-width:40rem){.symptom-story{padding-block:3.5rem}.symptom-layer{padding:1rem 1.15rem}.symptom-layer p{font-size:clamp(1.3rem,5vw,1.75rem)}}
</style>