<div class="three-orbit-field" data-three-orbit aria-hidden="true"><canvas></canvas></div>
<script>
  // Three.js is MIT licensed. The SVG hero remains visible if WebGL2 is unavailable.
  import type { WebGLRenderer } from 'three';

  document.querySelectorAll<HTMLElement>('[data-three-orbit]').forEach(container => {
    const canvas = container.querySelector('canvas');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const compact = matchMedia('(max-width: 40rem)');
    let visible = false;
    let loading = false;
    let renderer: WebGLRenderer | undefined;
    let resizeObserver: ResizeObserver | undefined;
    const disposables: Array<{ dispose: () => void }> = [];
    let render: ((time: number) => void) | undefined;
    const allowed = () => visible && !document.hidden && !reduced.matches && !compact.matches;
    const sync = () => {
      container.dataset.enabled = String(Boolean(renderer && allowed()));
      renderer?.setAnimationLoop(allowed() && render ? render : null);
      if (allowed() && !renderer) void initialize();
    };
    const initialize = async () => {
      if (!canvas || loading || renderer || !allowed()) return;
      loading = true;
      try {
        const gl = canvas.getContext('webgl2', { alpha: true, antialias: true, powerPreference: 'low-power' });
        if (!gl) return;
        const THREE = await import('three');
        if (!allowed()) return;
        renderer = new THREE.WebGLRenderer({ canvas, context: gl, alpha: true, antialias: true, powerPreference: 'low-power' });
        renderer.setClearColor(0x000000, 0);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.5));
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(39, 1, .1, 30);
        camera.position.z = 9;
        const constellation = new THREE.Group();
        scene.add(constellation);

        const dust = new Float32Array(420 * 3);
        const fraction = (value: number) => value - Math.floor(value);
        for (let i = 0; i < 420; i++) {
          const angle = fraction(Math.sin(i * 12.9898) * 43758.5453) * Math.PI * 2;
          const radius = 2.15 + fraction(Math.sin(i * 78.233) * 15243.535) * 1.75;
          dust[i * 3] = Math.cos(angle) * radius;
          dust[i * 3 + 1] = Math.sin(angle) * radius * .78;
          dust[i * 3 + 2] = (fraction(Math.sin(i * 31.4159) * 9631.417) - .5) * 2.8;
        }
        const dustGeometry = new THREE.BufferGeometry();
        dustGeometry.setAttribute('position', new THREE.BufferAttribute(dust, 3));
        const dustMaterial = new THREE.PointsMaterial({
          color: 0xcda8ff, size: .024, transparent: true, opacity: .7,
          blending: THREE.AdditiveBlending, depthWrite: false,
        });
        constellation.add(new THREE.Points(dustGeometry, dustMaterial));
        disposables.push(dustGeometry, dustMaterial);

        const bands = [
          { a: 2.65, b: 1.55, tilt: -.42, color: 0xa76bec, opacity: .42 },
          { a: 2.9, b: 1.28, tilt: .55, color: 0xc394ff, opacity: .32 },
          { a: 2.1, b: 2.15, tilt: 1.16, color: 0x8761d9, opacity: .24 },
        ];
        bands.forEach((band, bandIndex) => {
          const points: number[] = [];
          for (let i = 0; i < 200; i++) {
            const angle = i / 200 * Math.PI * 2;
            points.push(
              Math.cos(angle) * band.a,
              Math.sin(angle) * band.b,
              Math.sin(angle * 2 + bandIndex) * .33,
            );
          }
          const geometry = new THREE.BufferGeometry();
          geometry.setAttribute('position', new THREE.Float32BufferAttribute(points, 3));
          const material = new THREE.LineBasicMaterial({
            color: band.color, transparent: true, opacity: band.opacity,
            blending: THREE.AdditiveBlending, depthWrite: false,
          });
          const line = new THREE.LineLoop(geometry, material);
          line.rotation.z = band.tilt;
          constellation.add(line);
          disposables.push(geometry, material);
        });

        const resize = () => {
          if (!renderer) return;
          const { width, height } = container.getBoundingClientRect();
          if (width < 1 || height < 1) return;
          renderer.setSize(width, height, false);
          camera.aspect = width / height;
          camera.updateProjectionMatrix();
        };
        resizeObserver = new ResizeObserver(resize);
        resizeObserver.observe(container);
        resize();
        render = (time: number) => {
          const seconds = time * .001;
          constellation.rotation.y = Math.sin(seconds * .25) * .3;
          constellation.rotation.z = seconds * .045;
          constellation.rotation.x = Math.sin(seconds * .18) * .14;
          renderer?.render(scene, camera);
        };
        sync();
      } catch {
        container.dataset.enabled = 'false';
      } finally {
        loading = false;
      }
    };
    const observer = new IntersectionObserver(([entry]) => {
      visible = Boolean(entry?.isIntersecting);
      sync();
    }, { rootMargin: '120px' });
    observer.observe(container);
    document.addEventListener('visibilitychange', sync);
    reduced.addEventListener('change', sync);
    compact.addEventListener('change', sync);
    window.addEventListener('pagehide', () => {
      observer.disconnect();
      resizeObserver?.disconnect();
      renderer?.setAnimationLoop(null);
      disposables.forEach(item => item.dispose());
      renderer?.dispose();
    }, { once: true });
  });
</script>
<style>
  .three-orbit-field{position:absolute;z-index:0;inset:-8%;pointer-events:none;opacity:0;transition:opacity 900ms ease}
  .three-orbit-field[data-enabled='true']{opacity:.85}
  .three-orbit-field canvas{width:100%;height:100%;display:block}
  @media(max-width:40rem),(prefers-reduced-motion:reduce){.three-orbit-field{display:none}}
</style>
