---
import { siteContent } from '../content/site-content';
const areas = [
 {name:'Posicionamento', route:'/estrategia', actionLabel:'Explorar Estratégia', x:25,y:16},
 {name:'Marca',route:'/branding',actionLabel:'Explorar Branding',x:75,y:16},
 {name:'Conversão',route:'/digital',actionLabel:'Explorar Digital',x:82,y:50},
 {name:'Tecnologia',route:'/tecnologia',actionLabel:'Explorar Tecnologia',x:75,y:84},
 {name:'Digital',route:'/digital',actionLabel:'Explorar Digital',x:25,y:84},
 {name:'Aquisição',route:'/marketing',actionLabel:'Explorar Marketing',x:18,y:50},
] as const;
---
<div class="orbital-system" data-orbital data-ambient>
 <div class="orbital-map">
  <svg viewBox="0 0 700 540" fill="none" aria-hidden="true">
   <defs><radialGradient id="orbital-aura"><stop stop-color="#7543c0" stop-opacity=".2"/><stop offset="1" stop-color="#7543c0" stop-opacity="0"/></radialGradient></defs>
   <circle cx="350" cy="270" r="250" fill="url(#orbital-aura)"/>
   <g class="ambient orbit-a">
    <ellipse cx="350" cy="270" rx="273" ry="137" transform="rotate(-31 350 270)" stroke="#8e6ab4" stroke-opacity=".6" stroke-width=".8"/>
    <ellipse cx="350" cy="270" rx="273" ry="137" transform="rotate(-31 350 270)" stroke="#e1c6ff" stroke-width="1.8" stroke-linecap="round" stroke-dasharray="80 1300"/>
    <circle cx="121" cy="419" r="3.5" fill="#f1e4ff"/>
   </g>
   <g class="ambient orbit-b">
    <ellipse cx="350" cy="270" rx="225" ry="204" transform="rotate(36 350 270)" stroke="#6a4b8b" stroke-opacity=".7" stroke-width=".75" stroke-dasharray="1 8"/>
    <ellipse cx="350" cy="270" rx="225" ry="204" transform="rotate(36 350 270)" stroke="#be94f2" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="48 1250"/>
    <circle cx="539" cy="156" r="3" fill="#e2cdff"/>
   </g>
   <g class="ambient orbit-c">
    <ellipse cx="350" cy="270" rx="148" ry="258" transform="rotate(63 350 270)" stroke="#8056a4" stroke-opacity=".48" stroke-width=".7"/>
    <ellipse cx="350" cy="270" rx="148" ry="258" transform="rotate(63 350 270)" stroke="#d5a9fb" stroke-opacity=".65" stroke-width="1.2" stroke-dasharray="8 18"/>
   </g>
   {areas.map((a,i)=><g><path class="ambient orbit-connector" data-orbit-line={i} d={`M350 270L${a.x*7} ${a.y*5.4}`} stroke="#b690df" stroke-width="1"/><circle cx={a.x*7} cy={a.y*5.4} r="2.3" fill="#d9bcf2" fill-opacity=".65"/></g>)}
   <circle cx="350" cy="270" r="91" stroke="#ba8df4" stroke-opacity=".3" stroke-width=".7" stroke-dasharray="2 7"/>
  </svg>
  <div class="orbital-core"><img src="/brand/symbol-white.svg" width="78" height="78" alt="Bescheiben"/></div>
  <div role="group" aria-label="Disciplinas do sistema" class="orbital-nodes">{areas.map((a,i)=><button style={`--x:${a.x}%;--y:${a.y}%`} aria-expanded={i===0?'true':'false'} aria-controls={`orbital-detail-${i}`} data-orbit-node={i}><span aria-hidden="true"></span>{a.name}</button>)}</div>
 </div>
 <div class="orbital-detail">{areas.map((a,i)=><div hidden={i!==0} id={`orbital-detail-${i}`}><h3>{a.name}</h3><p>{siteContent[a.route].hero.supportingCopy[0]}</p><a href={a.route}>{a.actionLabel}<span aria-hidden="true"> ↗</span></a></div>)}</div>
</div>
<script>
 document.querySelectorAll<HTMLElement>('[data-orbital]').forEach(system=>{
  const nodes=[...system.querySelectorAll<HTMLButtonElement>('[data-orbit-node]')];
  const panels=[...system.querySelectorAll<HTMLElement>('.orbital-detail > div')];
  const lines=[...system.querySelectorAll<SVGPathElement>('[data-orbit-line]')];
  const reducedMotion=matchMedia('(prefers-reduced-motion: reduce)');
  let committed=0;
  let active=-1;
  const set=(next:number,engaged:boolean,animate=true)=>{
   const changed=active!==next;
   active=next;
   system.classList.toggle('is-engaged',engaged);
   nodes.forEach((node,index)=>{
    const selected=index===next;
    node.setAttribute('aria-expanded',String(selected));
    node.classList.toggle('is-muted',engaged&&!selected);
   });
   lines.forEach((line,index)=>line.classList.toggle('is-active',index===next));
   panels.forEach((panel,index)=>{
    const selected=index===next;
    panel.hidden=!selected;
    if(selected&&changed&&animate&&!reducedMotion.matches&&!document.hidden){
     panel.animate([{opacity:.45,transform:'translateY(8px)'},{opacity:1,transform:'translateY(0)'}],{duration:320,easing:'cubic-bezier(.2,0,0,1)'});
    }
   });
  };
  nodes.forEach((node,index)=>{
   node.addEventListener('click',()=>{committed=index;set(index,true);});
   node.addEventListener('focus',()=>set(index,true));
   node.addEventListener('pointerenter',event=>{if(event.pointerType==='mouse')set(index,true);});
   node.addEventListener('keydown',event=>{
    let next:number;
    if(event.key==='ArrowRight'||event.key==='ArrowDown')next=(index+1)%nodes.length;
    else if(event.key==='ArrowLeft'||event.key==='ArrowUp')next=(index+nodes.length-1)%nodes.length;
    else return;
    event.preventDefault();nodes[next].focus();
   });
  });
  system.addEventListener('pointerleave',()=>{if(!system.matches(':focus-within'))set(committed,false,false);});
  system.addEventListener('focusout',event=>{if(!system.contains(event.relatedTarget as Node|null)&&!system.matches(':hover'))set(committed,false,false);});
  set(0,false,false);
 });
</script>
<style>
.orbital-system{color:#fcfbfe;display:grid;grid-template-columns:minmax(0,1.45fr) minmax(15rem,.72fr);gap:clamp(1.5rem,3vw,3rem);align-items:center}
.orbital-map{position:relative;aspect-ratio:700/540;overflow:hidden}.orbital-map svg{position:absolute;inset:0;width:100%;height:100%;overflow:hidden}
.orbit-a,.orbit-b,.orbit-c{transform-origin:350px 270px}.orbit-a{animation:orbit-turn 18s linear infinite}.orbit-b{animation:orbit-turn 26s linear infinite reverse}.orbit-c{animation:orbit-turn 37s linear infinite}
.orbit-connector{stroke-opacity:.24;transition:stroke-opacity 300ms,stroke-width 300ms}.orbit-connector.is-active{stroke:#deb5ff;stroke-opacity:.95;stroke-width:1.7;stroke-dasharray:5 9;animation:orbit-signal 1.35s linear infinite}
.orbital-core{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:23%;aspect-ratio:1;display:grid;place-items:center;border-radius:50%;background:radial-gradient(circle at 30% 20%,#432767,#120a20 66%);border:1px solid #a476dd;box-shadow:0 0 0 12px #7b4cac0f,0 0 42px #9858e64f,inset 0 0 25px #9858e52e}.orbital-core img{width:50%;height:auto}
.orbital-nodes button{position:absolute;left:var(--x);top:var(--y);transform:translate(-50%,-50%);min-height:44px;padding:.65rem 1rem;display:flex;align-items:center;gap:.7rem;background:#130c21;border:1px solid #9f79c677;border-radius:99px;color:#e4d7f2;font-size:.83rem;white-space:nowrap;box-shadow:0 3px 18px #08040f80;transition:opacity 250ms,transform 250ms,color 250ms,border-color 250ms,box-shadow 250ms}.orbital-nodes button span{width:8px;height:8px;border-radius:50%;border:1px solid #d1a2ff;flex:none}.orbital-nodes button:hover,.orbital-nodes button:focus-visible,.orbital-nodes button[aria-expanded=true]{color:#fff;border-color:#d5a8ff;box-shadow:0 0 0 4px #a358e11a,0 0 24px #a358e155}.orbital-nodes button[aria-expanded=true] span{background:#ead2ff;box-shadow:0 0 10px #c183ef}.orbital-nodes button.is-muted{opacity:.46}.orbital-nodes button:focus-visible{outline:2px solid #ead0ff;outline-offset:4px}
.orbital-detail{position:relative;border-left:1px solid #765390a6;padding-left:2rem;min-height:190px}.orbital-detail::before{content:'';position:absolute;left:-3px;top:0;width:5px;height:5px;border-radius:50%;background:#e8caff;box-shadow:0 0 12px #c183ef}.orbital-detail h3{color:#e8c9ff;font-size:clamp(1.4rem,2vw,1.8rem);margin-bottom:.75rem}.orbital-detail p{font-size:.95rem;line-height:1.65;color:#cbbbdc}.orbital-detail a{min-height:44px;display:inline-flex;align-items:center;gap:1rem;color:#e3ccfc;font-size:.82rem;text-decoration-color:#b895da}.orbital-detail a:hover{color:#fff}
@keyframes orbit-signal{to{stroke-dashoffset:-28}}
@media(max-width:64rem){.orbital-system{grid-template-columns:1fr;gap:1.5rem}.orbital-map{max-width:42rem;width:100%;margin:auto}.orbital-detail{min-height:150px;border-left:0;border-top:1px solid #765390a6;padding:1.5rem 0 0}.orbital-detail::before{left:0;top:-3px}}
@media(max-width:40rem){.orbital-map{aspect-ratio:auto;padding-top:6rem;overflow:visible}.orbital-map>svg{display:none}.orbital-core{width:4.5rem;height:4.5rem;top:0;left:50%;transform:translateX(-50%)}.orbital-nodes{display:grid;grid-template-columns:1fr 1fr;gap:.7rem;position:relative}.orbital-nodes::before{position:absolute;content:'';left:50%;top:-1.5rem;bottom:0;width:1px;background:#78509355}.orbital-nodes button{position:relative;inset:auto;transform:none;white-space:normal;font-size:.8rem;padding:.7rem;border-radius:var(--radius-sm)}.orbital-detail{min-height:180px}.orbital-nodes button.is-muted{opacity:.65}}
@media(prefers-reduced-motion:reduce){.orbit-a,.orbit-b,.orbit-c,.orbit-connector{animation:none!important}.orbital-nodes button,.orbit-connector{transition:none!important}}
</style>
