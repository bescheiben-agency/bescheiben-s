---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'inverse' | 'text';
  class?: string;
  type?: 'button' | 'submit';
  disabled?: boolean;
  loading?: boolean;
  block?: boolean;
  target?: string;
  rel?: string;
}

const {
  href,
  variant = 'primary',
  class: className = '',
  type = 'button',
  disabled = false,
  loading = false,
  block = false,
  target,
  rel,
} = Astro.props;
const classes = ['button', `button--${variant}`, block && 'button--block', className];
---

{href ? (
  <a class:list={classes} href={href} target={target} rel={rel}>
    <span class="button__label"><slot /></span>
    <svg class="button__arrow" viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </a>
) : (
  <button class:list={classes} type={type} disabled={disabled || loading} aria-busy={loading ? 'true' : undefined}>
    <span class="button__label"><slot /></span>
    <svg class="button__arrow" viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </button>
)}

<style>
  .button {
    --button-edge: color-mix(in srgb, var(--purple-violet) 74%, var(--purple-lavender));
    position: relative;
    display: inline-flex;
    min-height: 3.125rem;
    align-items: center;
    justify-content: center;
    gap: 1.8rem;
    padding: 0.8rem 1.4rem;
    border: 1px solid var(--button-edge);
    border-radius: var(--radius-pill);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    box-shadow: inset 0 0 0 3px var(--purple-midnight), inset 0 0 0 4px color-mix(in srgb, var(--purple-lavender) 15%, transparent), 0 0 14px color-mix(in srgb, var(--purple-violet) 9%, transparent);
    transition: color var(--duration-fast) var(--ease-standard), background-color var(--duration-fast) var(--ease-standard), border-color var(--duration-fast) var(--ease-standard), box-shadow var(--duration-fast) var(--ease-standard);
  }

  .button__label { position: relative; z-index: 1; }
  .button__arrow { flex: 0 0 1.25rem; transition: transform var(--duration-fast) var(--ease-standard); }
  .button:hover { border-color: var(--purple-lavender); box-shadow: inset 0 0 0 3px var(--purple-midnight), inset 0 0 0 4px color-mix(in srgb, var(--purple-lavender) 32%, transparent), 0 0 20px color-mix(in srgb, var(--purple-violet) 22%, transparent); }
  .button:hover .button__arrow { transform: translateX(3px); }
  .button:focus-visible { outline-color: var(--purple-lavender); outline-offset: 5px; }
  .button:disabled { cursor: not-allowed; opacity: 0.58; }
  .button:disabled .button__arrow { transform: none; }
  .button[aria-busy='true'] .button__arrow { opacity: 0.4; }
  .button--block { width: 100%; }
  .button--primary, .button--inverse { color: var(--neutral-paper); background: var(--purple-midnight); }
  .button--primary:hover, .button--inverse:hover { background: color-mix(in srgb, var(--purple-deep) 22%, var(--purple-midnight)); }
  .button--secondary { color: var(--purple-deep); background: transparent; box-shadow: none; }
  .button--secondary:hover { color: var(--purple-midnight); background: color-mix(in srgb, var(--purple-violet) 6%, transparent); box-shadow: none; }
  .button--text { min-height: 2.75rem; padding-inline: 0; gap: 1rem; border-color: transparent; border-radius: 0; color: inherit; background: transparent; box-shadow: none; }
  .button--text .button__label { text-decoration: underline; text-decoration-color: color-mix(in srgb, currentColor 45%, transparent); text-underline-offset: 0.35em; }
  .button--text:hover { border-color: transparent; background: transparent; box-shadow: none; }
  .button--text:hover .button__label { text-decoration-color: currentColor; }

  @media (prefers-reduced-motion: reduce) {
    .button, .button__arrow { transition: none; }
    .button:hover .button__arrow { transform: none; }
  }
</style>
