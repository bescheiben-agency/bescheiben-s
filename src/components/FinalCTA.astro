---
import Button from './Button.astro';
import ReactiveLines from './ReactiveLines.astro';
interface Action{label:string;href:string;variant?:'primary'|'secondary'|'inverse'|'text';}
interface Props{eyebrow?:string;title:string;body?:string|string[];actions:Action[];artwork?:'diagnostic'|'institutional';}
const {title,body,actions}=Astro.props;
const paragraphs=Array.isArray(body)?body:body?[body]:[];
---
<section class="final-cta">
  <ReactiveLines/>
  <div class:list={['container','final-cta__inner',!title&&!paragraphs.length&&'final-cta__inner--actions-only']}>
    {(title||paragraphs.length>0)&&<div class="final-cta__message">
      {title&&<h2>{title}</h2>}
      {paragraphs.length>0&&<div class="final-cta__copy">{paragraphs.map(paragraph=><p>{paragraph}</p>)}</div>}
    </div>}
    <div class="final-cta__actions">{actions.map((a,i)=><Button href={a.href} variant={i===0?'inverse':'text'}>{a.label}</Button>)}</div>
  </div>
</section>
<style>
  .final-cta{position:relative;isolation:isolate;overflow:hidden;padding-block:clamp(5rem,8vw,8rem);color:var(--text-inverse);background:radial-gradient(ellipse at 80% 50%,#4a227547,transparent 48%),#1a0d2b;border-top:1px solid #be8dec55}
  .final-cta::after{content:'';pointer-events:none;position:absolute;right:-4rem;top:-12rem;width:34rem;height:34rem;border:1px solid #b377e935;border-radius:50%}
  .final-cta__inner{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:clamp(2rem,6vw,7rem);align-items:center}
  .final-cta__inner--actions-only{grid-template-columns:1fr}
  .final-cta__message{max-width:55rem}
  .final-cta h2{font-size:clamp(2.6rem,4.5vw,5rem);line-height:1.08;letter-spacing:-.05em;max-width:18ch;margin-bottom:1.5rem}
  .final-cta__copy{max-width:62ch;display:flex;flex-wrap:wrap;column-gap:.3em;row-gap:.2rem}
  .final-cta p{color:#d6c5e6;margin:0;font-size:clamp(.95rem,1.12vw,1.1rem);line-height:1.7}
  .final-cta__actions{display:flex;align-items:center;gap:1rem;flex-wrap:wrap}
  .final-cta__actions :global(.button--text){color:#e4cbf7}
  @media(max-width:50rem){.final-cta__inner{grid-template-columns:1fr;gap:1.5rem}.final-cta :global(.reactive-lines){opacity:.45}}
  @media(prefers-reduced-motion:reduce){.final-cta :global(.reactive-lines){opacity:.4}}
</style>
