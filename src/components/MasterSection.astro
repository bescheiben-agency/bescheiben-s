---
import type { ContentSection, CallToAction } from '../content/site-content';
import { parseMasterMarkdown } from '../utils/master-markdown';
import CopyBlocks from './CopyBlocks.astro';
import CapabilityVisual from './CapabilityVisual.astro';
import OrbitalSystem from './OrbitalSystem.astro';

interface Props { section:ContentSection; index:number; route:string; ctas?:readonly CallToAction[]; }
const { section,index,route,ctas=[] }=Astro.props;
const blocks=parseMasterMarkdown(section.body);
const titleIndex=blocks.findIndex(block=>block.type==='heading');
const internalMarker=/^SEÇÃO\s+\d+/i.test(section.heading);
const title=internalMarker&&titleIndex>=0&&'text' in blocks[titleIndex]?blocks[titleIndex].text:section.heading;
const content=blocks.filter((block,i)=>
  !(i===titleIndex&&block.type==='heading'&&block.text===title) &&
  !(block.type==='eyebrow'&&i===0) &&
  !('text' in block&&['FECHO','MAPA DO SISTEMA','↓'].includes(block.text.toUpperCase()))
);
const system=route==='/'&&section.id==='um-unico-sistema';
const stages=system?content.filter(block=>block.type==='statement'&&'text' in block&&block.text===block.text.toUpperCase()):[];
const prose=system?content.filter(block=>!stages.includes(block)):content;
const markerIndex=system?prose.findIndex(block=>block.type==='eyebrow'&&block.text.toLowerCase()==='sistema bescheiben'):-1;
const systemIntro=markerIndex>=0?prose.slice(0,markerIndex):prose;
const systemClosing=markerIndex>=0?prose.slice(markerIndex+1):[];
const illustrated=['branding','marketing','digital','inteligencia-artificial'].includes(section.id)||(route!=='/'&&index===0);
const spotlight=['competicao','falta-de-conteudo','mais-do-que-interface','estrategia-nao-e-lista','nossa-visao-sobre-ia','nossa-crenca'].includes(section.id);
const dark=system||spotlight||(route==='/'&&['nosso-ponto-de-vista','inteligencia-artificial'].includes(section.id));
const compact=!system&&!illustrated&&content.length<=3;
const sequence=!system&&content.filter(block=>block.type==='paragraph'&&block.text.length<100).length>=4;
const reverse=!system&&!illustrated&&index%3===2;
const visual=route.includes('branding')||section.id==='branding'?'layers':route.includes('marketing')||section.id==='marketing'?'flow':route.includes('digital')||section.id==='digital'?'interface':route.includes('tecnologia')||section.id==='inteligencia-artificial'?'ring':'orbit';
const nodes=[
  {x:280,y:82},{x:420,y:130},{x:478,y:268},{x:425,y:410},
  {x:280,y:478},{x:135,y:410},{x:82,y:268},{x:140,y:130},
];
---
<section id={section.id} data-copy-section={section.id} class:list={['master-section',dark&&'master-section--inverse',system&&'master-section--system',illustrated&&'master-section--illustrated',spotlight&&'master-section--spotlight',compact&&'master-section--compact',sequence&&'master-section--sequence',reverse&&'master-section--reverse']}>
  <div class="container">
    {system?<>
      <div class="system-intro">
        <h2>{title}</h2>
        <div class="system-intro__copy"><CopyBlocks blocks={systemIntro} ctas={ctas}/></div>
      </div>
      <div class="system-journey">
        <div class="system-network" aria-hidden="true">
          <svg viewBox="0 0 560 560" fill="none">
            <circle class="system-network__halo" cx="280" cy="280" r="212"/>
            {nodes.slice(0,stages.length).map(node=><line class="system-network__spoke" x1="280" y1="280" x2={node.x} y2={node.y}/>)}
            <path class="system-network__track" d="M280 82L420 130L478 268L425 410L280 478L135 410L82 268L140 130"/>
            {nodes.slice(0,stages.length).map(node=><circle class="system-network__node" cx={node.x} cy={node.y} r="5"/>)}
          </svg>
          <div class="system-network__core"><img src="/brand/symbol-white.svg" width="88" height="88" alt=""/></div>
        </div>
        <div class="system-stages" aria-label="Elementos do sistema Bescheiben">
          {stages.map(block=><div class="system-stage">
            <span class="system-stage__point" aria-hidden="true"></span>
            <h3>{'text' in block?block.text:''}</h3>
          </div>)}
        </div>
      </div>
      {systemClosing.length>0&&<div class="system-closing"><CopyBlocks blocks={systemClosing} ctas={ctas}/></div>}
      <div class="system-orbital"><OrbitalSystem/></div>
    </>:<>
      <div class="section-composition">
        <header>
          <h2>{title}</h2>
          {illustrated&&<div class="section-visual" data-ambient><CapabilityVisual kind={visual} id={'visual-'+section.id}/></div>}
        </header>
        <div class="copy-prose"><CopyBlocks blocks={content} ctas={ctas}/></div>
      </div>
    </>}
  </div>
</section>
<style>
.master-section{position:relative;isolation:isolate;padding-block:clamp(4.5rem,8vw,8.5rem);background:var(--bg-paper)}
.master-section:nth-child(even){background:var(--bg-light)}
.master-section--inverse,.master-section--inverse:nth-child(even){background:var(--bg-dark);color:var(--text-inverse)}
.section-composition{display:grid;grid-template-columns:minmax(0,.95fr) minmax(0,1.05fr);gap:clamp(2rem,6vw,8rem);align-items:start}
.section-composition>header{min-width:0}.section-composition h2{max-width:22ch;margin:0;font-size:clamp(2.1rem,3.45vw,3.8rem);line-height:1.1;text-wrap:balance}
.copy-prose{min-width:0;max-width:65ch;padding-top:.35rem}
.copy-prose :global(p){font-size:clamp(.98rem,1.1vw,1.125rem);color:var(--text-secondary);line-height:1.8;margin-bottom:1.25rem}
.copy-prose :global(h3){font-family:var(--font-body);font-size:clamp(1.1rem,1.6vw,1.55rem);letter-spacing:-.035em;margin-block:2.5rem 1rem}
.copy-prose :global(.copy-statement){font-family:var(--font-display);font-size:clamp(1.5rem,2.5vw,2.55rem);color:var(--text-primary);line-height:1.28;letter-spacing:-.04em;margin:2rem 0}
.copy-prose :global(ul),.copy-prose :global(ol){padding:0;list-style:none;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,14rem),1fr));gap:0 1.5rem;margin-block:2rem}
.copy-prose :global(li){padding:.9rem 0;border-top:1px solid var(--border-default);font-size:.9rem;line-height:1.55}
.copy-prose :global(.copy-action){margin-block:1.75rem}
.master-section--inverse .copy-prose :global(p){color:var(--ink-on-dark)}.master-section--inverse .copy-prose :global(.copy-statement){color:var(--text-inverse)}.master-section--inverse :global(.button--text){color:var(--purple-lavender)}.master-section--inverse .copy-prose :global(li){border-color:#72508066}
.section-visual{position:relative;width:min(100%,35rem);height:clamp(16rem,26vw,25rem);margin-top:clamp(1.5rem,3vw,3rem);overflow:hidden;background:radial-gradient(ellipse at 60% 50%,#6c3daf42,transparent 48%),linear-gradient(145deg,#1c1130,#0d081a);border:1px solid #b098d533;clip-path:polygon(0 0,100% 0,100% 87%,87% 100%,0 100%)}
.section-visual:before{content:'';position:absolute;z-index:1;inset:13% 9%;border:1px solid #bd95e125;border-radius:50%;pointer-events:none}
.section-visual :global(svg){position:absolute;inset:0;width:100%;height:100%;transform:scale(1.08);transform-origin:center}
.master-section--reverse .section-composition>header{grid-column:2;grid-row:1}.master-section--reverse .section-composition>.copy-prose{grid-column:1;grid-row:1}
.master-section--spotlight{background:radial-gradient(ellipse at 85% 12%,#4826694d,transparent 46%),var(--bg-dark)}
.master-section--spotlight .section-composition{grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr)}.master-section--spotlight h2{font-size:clamp(2.7rem,4.8vw,5.5rem);max-width:17ch}.master-section--spotlight .copy-prose :global(p){font-size:clamp(1.1rem,1.45vw,1.4rem);line-height:1.65}
.master-section--compact{padding-block:clamp(3.75rem,6vw,6.5rem)}.master-section--compact .copy-prose :global(p:first-child){font-size:clamp(1.15rem,1.65vw,1.55rem);line-height:1.58;color:var(--text-primary)}
.master-section--compact.master-section--inverse .copy-prose :global(p:first-child){color:var(--text-inverse)}
.master-section--sequence .copy-prose :global(p){padding-block:.65rem;margin:0;border-bottom:1px solid var(--border-default)}.master-section--sequence.master-section--inverse .copy-prose :global(p){border-color:#b89ad52e}
.master-section--illustrated .section-composition{grid-template-columns:minmax(0,.95fr) minmax(0,1.05fr)}
.master-section--system{padding-block:clamp(5rem,9vw,9rem);overflow:clip}
.system-intro{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.9fr);gap:clamp(2rem,6vw,7rem);align-items:start;padding-bottom:clamp(2.5rem,5vw,5rem);border-bottom:1px solid #ac80d036}
.system-intro h2{max-width:19ch;font-size:clamp(2.5rem,4vw,4.65rem);line-height:1.08}.system-intro__copy{max-width:60ch}.system-intro__copy :global(p){font-size:clamp(.98rem,1.18vw,1.13rem);line-height:1.75;color:#c9bcdb}
.system-journey{display:grid;grid-template-columns:minmax(0,.95fr) minmax(0,1.05fr);gap:clamp(2rem,5vw,6rem);align-items:center;padding-top:clamp(2.5rem,5vw,5rem)}
.system-network{position:relative;width:min(100%,29rem);aspect-ratio:1;margin-inline:auto;display:grid;place-items:center}
.system-network svg{width:100%;height:100%;overflow:visible}.system-network__halo{stroke:#9270b33e;stroke-width:1}.system-network__spoke{stroke:#b48aeb80;stroke-width:1.3}
.system-network__track{stroke:#9a78be4d;stroke-width:1}.system-network__node{fill:#ead8ff;stroke:#1a0c2d;stroke-width:5}
.system-network__core{position:absolute;width:25%;aspect-ratio:1;border-radius:50%;display:grid;place-items:center;border:1px solid #a57ac971;background:radial-gradient(circle at 30% 20%,#4d2b67,#110a1d 70%);box-shadow:0 0 55px #8147c52b,inset 0 0 24px #a65aff26}.system-network__core img{width:58%;height:auto}
.system-stages{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem}.system-stage{position:relative;display:flex;align-items:center;min-height:6.25rem;padding:1rem 1.2rem;border:1px solid #ac80d036;background:#b987ed08}.system-stage__point{width:7px;height:7px;margin-right:.7rem;border-radius:50%;flex:none;background:#d4affd;box-shadow:0 0 12px #a868e6}
.system-stage h3{margin:0;font-family:var(--font-display);font-size:clamp(1.15rem,1.6vw,1.7rem);font-weight:400;line-height:1.2;letter-spacing:-.025em;color:#f7efff}
.system-closing{display:flex;flex-wrap:wrap;gap:.7rem 2rem;padding-block:clamp(2.5rem,5vw,5rem);border-top:1px solid #ac80d036}.system-closing :global(p){font-family:var(--font-display);font-size:clamp(1.5rem,2.4vw,2.7rem);line-height:1.25;margin:0;color:#e7d8f9}.system-closing :global(p:last-child){color:#af80e7}
.system-orbital{border-top:1px solid #ac80d036;padding-top:clamp(2.5rem,5vw,5rem)}
@media(max-width:64rem){.section-composition,.master-section--spotlight .section-composition,.master-section--illustrated .section-composition{gap:2rem;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr)}.system-journey{gap:2rem}}
@media(max-width:48rem){.master-section{padding-block:clamp(3.5rem,8vw,5.5rem)}.section-composition,.master-section--spotlight .section-composition,.master-section--illustrated .section-composition{display:flex;flex-direction:column;gap:1.5rem}.section-visual{height:clamp(15rem,48vw,22rem);width:100%;max-width:33rem;margin-top:1.5rem}.copy-prose{padding-top:0}.system-intro{grid-template-columns:1fr;gap:1.5rem}.system-intro h2{margin:0}.system-journey{grid-template-columns:1fr;gap:1.5rem}.system-network{width:min(60vw,17rem)}.system-stage h3{font-size:clamp(1.15rem,3vw,1.6rem)}}
@media(max-width:40rem){.section-composition h2{font-size:clamp(2.15rem,8vw,3.1rem)}.master-section--spotlight h2{font-size:clamp(2.6rem,9.5vw,3.8rem)}.system-stages{gap:.5rem}.system-stage{min-height:5rem;padding:.7rem}.system-stage__point{width:5px;height:5px;margin-right:.5rem}.system-stage h3{font-size:clamp(.78rem,3vw,.95rem);white-space:nowrap}.system-closing{display:block}.system-closing :global(p+p){margin-top:.65rem}}
</style>
