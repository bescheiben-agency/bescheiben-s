---
import Button from './Button.astro';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
---
<section id="formulario" class="contact-section">
  <div class="container contact-grid">
    <header class="contact-intro">
      <p class="contact-index">Início da conversa</p>
      <h2>Comece pelo contexto.</h2>
      <p>Conte o que está acontecendo. Vamos entender o problema antes de propor um caminho.</p>
    </header>

    <form class="diagnostic-form" aria-label="Solicitação de diagnóstico" data-diagnostic-form data-turnstile-configured={String(Boolean(turnstileSiteKey))} novalidate>
      {!turnstileSiteKey && <p class="form-availability" role="note">Envio online em preparação. Você também pode enviar seu contexto por <a href="mailto:bescheiben@gmail.com?subject=Diagn%C3%B3stico%20Bescheiben">e-mail</a>.</p>}
      <div class="form-status" data-form-status role="status" aria-live="polite" tabindex="-1" hidden></div>
      <div class="form-fields">
        <div class="form-row">
          <div class="field">
            <label for="name">Nome</label>
            <input id="name" name="name" autocomplete="name" minlength="2" maxlength="120" required />
            <small data-error-for="name"></small>
          </div>
          <div class="field">
            <label for="email">E-mail</label>
            <input id="email" name="email" type="email" autocomplete="email" maxlength="254" required />
            <small data-error-for="email"></small>
          </div>
        </div>
        <div class="field">
          <label for="company">Empresa <span>Opcional</span></label>
          <input id="company" name="company" autocomplete="organization" minlength="2" maxlength="160" />
          <small data-error-for="company"></small>
        </div>
        <div class="field">
          <label for="situation">O que está acontecendo?</label>
          <textarea id="situation" name="situation" rows="4" minlength="10" maxlength="1200" placeholder="Conte brevemente o que precisa mudar." required></textarea>
          <small data-error-for="situation"></small>
        </div>
        {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-size="compact" data-action="diagnostico" data-callback="bescheibenTurnstileSuccess" data-expired-callback="bescheibenTurnstileExpired"></div>}
      </div>
      <div class="form-submit">
        <Button type="submit">Enviar contexto</Button>
        <p>Usaremos esses dados apenas para analisar e responder ao contato. Leia a <a href="/privacidade">Política de Privacidade</a>.</p>
      </div>
      <div class="trap" aria-hidden="true"><label for="websiteTrap">Não preencha</label><input id="websiteTrap" name="websiteTrap" tabindex="-1" autocomplete="off" /></div>
      <input type="hidden" name="startedAt" data-started-at />
      <input type="hidden" name="turnstileToken" data-turnstile-token />
    </form>
  </div>
</section>

{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script is:inline>
  window.bescheibenTurnstileSuccess = (token) => {
    const input = document.querySelector('[data-turnstile-token]');
    if (input) input.value = token;
  };
  window.bescheibenTurnstileExpired = () => {
    const input = document.querySelector('[data-turnstile-token]');
    if (input) input.value = '';
  };

  const form = document.querySelector('[data-diagnostic-form]');
  if (form) {
    const status = form.querySelector('[data-form-status]');
    const submit = form.querySelector('button[type="submit"]');
    const startedAt = form.querySelector('[data-started-at]');
    startedAt.value = String(Date.now());

    const showStatus = (message, state = 'error') => {
      status.textContent = message;
      status.dataset.state = state;
      status.hidden = false;
      status.focus();
    };
    const clearErrors = () => {
      form.querySelectorAll('[aria-invalid="true"]').forEach((field) => field.removeAttribute('aria-invalid'));
      form.querySelectorAll('[data-error-for]').forEach((message) => { message.textContent = ''; });
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearErrors();
      if (!form.reportValidity()) return;
      if (form.dataset.turnstileConfigured !== 'true') {
        showStatus('O envio está temporariamente indisponível. Escreva para bescheiben@gmail.com.', 'fatal');
        return;
      }
      if (!form.querySelector('[data-turnstile-token]').value) {
        showStatus('Confirme a verificação de segurança antes de enviar.');
        return;
      }

      submit.disabled = true;
      submit.setAttribute('aria-busy', 'true');
      status.hidden = true;
      const payload = Object.fromEntries(new FormData(form).entries());
      // The widget adds its own field; the API accepts our callback token only.
      delete payload['cf-turnstile-response'];
      let delivered = false;
      try {
        const response = await fetch('/api/diagnostico', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok) {
          if (result.errors) Object.entries(result.errors).forEach(([field, message]) => {
            const control = form.querySelector('[name="' + CSS.escape(field) + '"]');
            const output = form.querySelector('[data-error-for="' + CSS.escape(field) + '"]');
            control?.setAttribute('aria-invalid', 'true');
            if (output) output.textContent = String(message);
          });
          showStatus(result.message || 'Não foi possível enviar. Revise os campos e tente novamente.');
          return;
        }
        form.reset();
        delivered = true;
        startedAt.value = String(Date.now());
        showStatus('Contexto recebido. Vamos analisar as informações e entrar em contato.', 'success');
        form.querySelector('.form-fields').hidden = true;
        form.querySelector('.form-submit').hidden = true;
      } catch {
        showStatus('A conexão falhou. Seu texto foi preservado; tente novamente em alguns minutos.');
      } finally {
        if (!delivered) {
          // Verification consumes the token even when delivery subsequently fails.
          form.querySelector('[data-turnstile-token]').value = '';
          const widget = form.querySelector('.cf-turnstile');
          if (widget && window.turnstile) window.turnstile.reset(widget);
        }
        submit.disabled = false;
        submit.removeAttribute('aria-busy');
      }
    });
  }
</script>

<style>
.contact-section{position:relative;padding-block:clamp(4rem,7vw,7rem);overflow:clip;color:var(--text-primary);background:radial-gradient(ellipse at 0% 0%,#e9defa 0%,transparent 38%),#f8f6fc}
.contact-section::before{position:absolute;inset:0 0 auto;height:1px;background:#d6c7e7;content:''}
.contact-grid{display:grid;grid-template-columns:minmax(0,.75fr) minmax(0,1fr);gap:clamp(2rem,5vw,5rem);align-items:start;max-width:74rem}
.contact-intro{padding-top:.5rem}
.contact-index{margin:0 0 1.7rem;color:#5d3a8b;font-size:.7rem;font-weight:700;letter-spacing:.17em;text-transform:uppercase}
.contact-intro h2{max-width:10ch;margin:0 0 1.4rem;font-size:clamp(3rem,4.5vw,5rem);line-height:1.02;font-weight:400;letter-spacing:-.065em}
.contact-intro>p:not(.contact-index){max-width:37ch;color:#5b4c6d;font-size:.98rem;line-height:1.7}
.contact-intro>p:last-child{margin-top:1.3rem;padding-top:1.1rem;border-top:1px solid #d8cbe4;font-size:.82rem}
.contact-intro a,.form-availability a,.form-submit a{color:#4b27a8;text-decoration-color:#9d7ec2}
.diagnostic-form{display:grid;gap:1.25rem;min-width:0;max-width:43rem;padding:clamp(1.25rem,2.7vw,2.5rem);border:1px solid #d3c3e5;border-top:3px solid #7d3cff;border-radius:.45rem;background:#fff;box-shadow:0 24px 70px #44246c12}
.form-availability{margin:0;padding:.8rem 1rem;border-left:3px solid #8551be;color:#4c3564;background:#f4ecff;font-size:.82rem;line-height:1.5}
.form-fields{display:grid;gap:1rem}
.form-row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}
.field{display:grid;align-content:start;gap:.4rem;min-width:0}
.field label{color:#352347;font-size:.82rem;font-weight:650;line-height:1.4}
.field label span{margin-left:.3rem;color:#756584;font-size:.72rem;font-weight:400}
.field input,.field textarea{width:100%;min-width:0;min-height:3rem;padding:.75rem .9rem;border:1px solid #cfc4d9;border-radius:.35rem;color:#241334;background:#fcfaff;font-size:.94rem;transition:border-color var(--duration-fast) var(--ease-standard),box-shadow var(--duration-fast) var(--ease-standard)}
.field textarea{min-height:6.5rem;resize:vertical;line-height:1.55}
.field input::placeholder,.field textarea::placeholder{color:#8d809a}
.field input:hover,.field textarea:hover{border-color:#a17bc5}
.field input:focus-visible,.field textarea:focus-visible{border-color:#6d32b6;outline:2px solid #6d32b6;outline-offset:2px;background:#fff;box-shadow:0 0 0 4px #a47adb15}
.field input[aria-invalid='true'],.field textarea[aria-invalid='true']{border-color:#ad334f}
.field small{color:#a02540;font-size:.75rem;line-height:1.5}.field small:empty{display:none}
.cf-turnstile{min-width:0;max-width:100%;overflow:hidden}
.trap{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}
.form-submit{display:grid;grid-template-columns:auto minmax(0,1fr);align-items:center;gap:1rem;padding-top:1.2rem;border-top:1px solid #e4dce9}
.form-submit p{max-width:38ch;margin:0;color:#685776;font-size:.72rem;line-height:1.6}
.form-status{padding:1rem 1.25rem;border:1px solid #da9bad;border-radius:.4rem;color:#772642;background:#fff2f5;line-height:1.6}
.form-status[data-state='success']{border-color:#9bc9ad;color:#1f5836;background:#edf9f0}
.form-status[data-state='fatal']{border-color:#ad334f}
[hidden]{display:none!important}
@media(max-width:52rem){.contact-grid{grid-template-columns:1fr;gap:2rem}.contact-intro h2{max-width:16ch}.contact-intro>p:not(.contact-index){max-width:60ch}.diagnostic-form{max-width:42rem}}
@media(max-width:40rem){.contact-section{padding-block:3.5rem}.contact-intro h2{font-size:clamp(2.8rem,11vw,3.6rem)}.form-row{grid-template-columns:1fr}.form-submit{grid-template-columns:1fr}.form-submit :global(.button){width:100%}}
@media(prefers-reduced-motion:reduce){.field input,.field textarea{transition:none}}
</style>
