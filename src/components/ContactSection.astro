---
import Button from './Button.astro';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
---
  <section id="formulario" class="contact-section">
    <div class="container contact-grid">
      <header class="contact-intro">
        <p class="contact-index"><span>01 — 03</span> Início da conversa</p>
        <h2>Comece pelo contexto.</h2>
        <p>Não esperamos que você saiba nomear o problema com precisão. O formulário existe para organizar os primeiros sinais e preparar uma conversa mais útil.</p>
        <p>Não precisamos que você descubra sozinho qual serviço contratar.</p>
        <p>Explique o cenário. O que está acontecendo. O que incomoda. O que gostaria que fosse diferente.</p>
        <p>A partir daí conseguimos começar a fazer as perguntas certas.</p>
        {turnstileSiteKey
          ? <p>Os dados são enviados diretamente para <a href="mailto:bescheiben@gmail.com">bescheiben@gmail.com</a>.</p>
          : <p>O envio pelo formulário está temporariamente indisponível. Para iniciar a conversa agora, escreva para <a href="mailto:bescheiben@gmail.com?subject=Diagn%C3%B3stico%20Bescheiben">bescheiben@gmail.com</a>.</p>}
      </header>

      <form class="diagnostic-form" aria-label="Solicitação de diagnóstico" data-diagnostic-form data-turnstile-configured={String(Boolean(turnstileSiteKey))} novalidate>
        {!turnstileSiteKey&&<p class="form-availability" role="note">Envio online em preparação. Se preferir, envie seu contexto por <a href="mailto:bescheiben@gmail.com?subject=Diagn%C3%B3stico%20Bescheiben">email</a>.</p>}
        <div class="form-status" data-form-status role="status" aria-live="polite" tabindex="-1" hidden></div>

        <section class="form-stage" aria-labelledby="form-stage-identity">
          <div class="form-stage__heading"><span class="form-stage__number">01</span><div><h3 id="form-stage-identity">Quem inicia a conversa</h3><p>As informações para entrarmos em contato.</p></div></div>
          <div class="form-stage__body">
            <div class="form-row form-row--split">
              <div class="field"><label for="name">Nome</label><input id="name" name="name" autocomplete="name" minlength="2" maxlength="120" aria-describedby="name-help" required /><p class="field-help" id="name-help">Como podemos chamar você?</p><small data-error-for="name"></small></div>
              <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" maxlength="254" required /><small data-error-for="email"></small></div>
            </div>
            <div class="form-row form-row--split">
              <div class="field"><label for="company">Empresa</label><input id="company" name="company" autocomplete="organization" minlength="2" maxlength="160" aria-describedby="company-help" required /><p class="field-help" id="company-help">Qual é a empresa?</p><small data-error-for="company"></small></div>
              <div class="field"><label for="website">Site ou perfil <span>Opcional</span></label><input id="website" name="website" inputmode="url" maxlength="300" placeholder="https://" aria-describedby="website-help" /><p class="field-help" id="website-help">Onde podemos conhecer melhor o negócio?</p><small data-error-for="website"></small></div>
            </div>
          </div>
        </section>

        <section class="form-stage" aria-labelledby="form-stage-scenario">
          <div class="form-stage__heading"><span class="form-stage__number">02</span><div><h3 id="form-stage-scenario">O cenário</h3><p>O que acontece hoje e o que você gostaria de mudar.</p></div></div>
          <div class="form-stage__body">
            <div class="field"><label for="situation">Qual situação motivou este contato?</label><textarea id="situation" name="situation" rows="6" minlength="20" maxlength="4000" aria-describedby="situation-help" required></textarea><p class="field-help" id="situation-help">Conte o que está acontecendo hoje.</p><small data-error-for="situation"></small></div>
            <div class="field"><label for="desiredChange">O que você gostaria que fosse diferente?</label><textarea id="desiredChange" name="desiredChange" rows="6" minlength="20" maxlength="4000" aria-describedby="desiredChange-help" required></textarea><p class="field-help" id="desiredChange-help">Não precisa descrever uma solução. Explique a mudança que gostaria de perceber.</p><small data-error-for="desiredChange"></small></div>
            <div class="field"><label for="attempted">O que já foi tentado? <span>Opcional</span></label><textarea id="attempted" name="attempted" rows="4" maxlength="3000" aria-describedby="attempted-help"></textarea><p class="field-help" id="attempted-help">Se alguma iniciativa já foi realizada, conte brevemente.</p><small data-error-for="attempted"></small></div>
            <div class="field"><label for="deadline">Existe algum prazo relevante? <span>Opcional</span></label><input id="deadline" name="deadline" maxlength="500" /><small data-error-for="deadline"></small></div>
          </div>
        </section>

        <section class="form-stage form-stage--last" aria-labelledby="form-stage-next">
          <div class="form-stage__heading"><span class="form-stage__number">03</span><div><h3 id="form-stage-next">Como seguimos</h3><p>Escolha o melhor caminho para nossa resposta.</p></div></div>
          <div class="form-stage__body">
            <fieldset class="preference-field">
              <legend>Como prefere continuar a conversa?</legend>
              <label><input type="radio" name="contactPreference" value="email" checked /> Email</label>
              <label><input type="radio" name="contactPreference" value="whatsapp" /> WhatsApp</label>
              <small data-error-for="contactPreference"></small>
            </fieldset>
            <div class="field" data-phone-field hidden>
              <label for="phone">Seu WhatsApp com DDD</label>
              <input id="phone" name="phone" type="tel" autocomplete="tel" maxlength="32" />
              <small data-error-for="phone"></small>
            </div>
            {turnstileSiteKey && (
              <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-size="compact" data-action="diagnostico" data-callback="bescheibenTurnstileSuccess" data-expired-callback="bescheibenTurnstileExpired"></div>
            )}
            <div class="form-submit">
              <Button type="submit">Enviar contexto</Button>
              <p>Ao enviar, você solicita que a Bescheiben use esses dados exclusivamente para analisar e responder a este contato. Leia a <a href="/privacidade">Política de Privacidade</a>.</p>
            </div>
          </div>
        </section>

        <div class="trap" aria-hidden="true"><label for="websiteTrap">Não preencha</label><input id="websiteTrap" name="websiteTrap" tabindex="-1" autocomplete="off" /></div>
        <input type="hidden" name="startedAt" data-started-at />
        <input type="hidden" name="turnstileToken" data-turnstile-token />
      </form>
    </div>
  </section>

{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script is:inline>
  window.bescheibenTurnstileSuccess = (token) => {
    const input = document.querySelector('[data-turnstile-token]');
    if (input) input.value = token;
  };
  window.bescheibenTurnstileExpired = () => {
    const input = document.querySelector('[data-turnstile-token]');
    if (input) input.value = '';
  };

  const form = document.querySelector('[data-diagnostic-form]');
  if (form) {
    const status = form.querySelector('[data-form-status]');
    const submit = form.querySelector('button[type="submit"]');
    const startedAt = form.querySelector('[data-started-at]');
    const phoneField = form.querySelector('[data-phone-field]');
    const phone = form.querySelector('[name="phone"]');
    startedAt.value = String(Date.now());

    const showStatus = (message, state = 'error') => {
      status.textContent = message;
      status.dataset.state = state;
      status.hidden = false;
      status.focus();
    };
    const clearErrors = () => {
      form.querySelectorAll('[aria-invalid="true"]').forEach((field) => field.removeAttribute('aria-invalid'));
      form.querySelectorAll('[data-error-for]').forEach((message) => { message.textContent = ''; });
    };
    const syncPhone = () => {
      const preference = form.querySelector('[name="contactPreference"]:checked')?.value;
      const visible = preference === 'whatsapp';
      phoneField.hidden = !visible;
      phone.required = visible;
      if (!visible) phone.value = '';
    };
    form.querySelectorAll('[name="contactPreference"]').forEach((control) => control.addEventListener('change', syncPhone));
    syncPhone();

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearErrors();
      if (!form.reportValidity()) return;
      if (form.dataset.turnstileConfigured !== 'true') {
        showStatus('O envio está temporariamente indisponível. Escreva para bescheiben@gmail.com.', 'fatal');
        return;
      }
      if (!form.querySelector('[data-turnstile-token]').value) {
        showStatus('Confirme a verificação de segurança antes de enviar.');
        return;
      }

      submit.disabled = true;
      submit.setAttribute('aria-busy', 'true');
      status.hidden = true;
      const payload = Object.fromEntries(new FormData(form).entries());
      // The widget adds its own field; the API accepts our callback token only.
      delete payload['cf-turnstile-response'];
      let delivered = false;
      try {
        const response = await fetch('/api/diagnostico', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok) {
          if (result.errors) Object.entries(result.errors).forEach(([field, message]) => {
            const control = form.querySelector(`[name="${CSS.escape(field)}"]`);
            const output = form.querySelector(`[data-error-for="${CSS.escape(field)}"]`);
            control?.setAttribute('aria-invalid', 'true');
            if (output) output.textContent = String(message);
          });
          showStatus(result.message || 'Não foi possível enviar. Revise os campos e tente novamente.');
          return;
        }
        form.reset();
        delivered = true;
        syncPhone();
        startedAt.value = String(Date.now());
        showStatus('Contexto recebido. Vamos analisar as informações antes de continuar a conversa. Caso seja necessário compreender algum ponto adicional, entraremos em contato.', 'success');
        form.querySelectorAll('.form-stage').forEach((element) => { element.hidden = true; });
      } catch {
        showStatus('A conexão falhou. Seu texto foi preservado; tente novamente em alguns minutos.');
      } finally {
        if (!delivered) {
          // Verification consumes the token even when delivery subsequently fails.
          form.querySelector('[data-turnstile-token]').value = '';
          const widget = form.querySelector('.cf-turnstile');
          if (widget && window.turnstile) window.turnstile.reset(widget);
        }
        submit.disabled = false;
        submit.removeAttribute('aria-busy');
      }
    });
  }
</script>

<style>
  .contact-section { position: relative; padding-block: clamp(4.5rem, 8vw, 8rem); overflow: clip; color: var(--text-primary); background: radial-gradient(ellipse at 0% 0%, #e9defa 0%, transparent 38%), #f8f6fc; }
  .contact-section::before { position: absolute; top: 0; right: 0; left: 0; height: 1px; background: #d6c7e7; content: ''; }
  .contact-grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: clamp(3rem, 5vw, 6rem); align-items: start; }
  .contact-intro { position: sticky; top: 7rem; padding-top: 1rem; }
  .contact-index { display: flex; align-items: center; gap: 1rem; margin-bottom: 2.5rem !important; color: #5d3a8b !important; font-size: .7rem !important; font-weight: 700; letter-spacing: .17em; text-transform: uppercase; }
  .contact-index span { padding-right: 1rem; border-right: 1px solid #baa1d4; font-variant-numeric: tabular-nums; }
  .contact-intro h2 { max-width: 10ch; margin-bottom: 2rem; font-size: clamp(3.1rem, 4.5vw, 5rem); line-height: 1.02; font-weight: 400; letter-spacing: -.065em; }
  .contact-intro > p:not(.contact-index) { max-width: 43ch; color: #5b4c6d; font-size: .94rem; line-height: 1.75; }
  .contact-intro > p:last-child { max-width: 38ch; margin-top: 2rem; padding-top: 1.3rem; border-top: 1px solid #d8cbe4; font-size: .82rem; }
  .contact-intro a { color: #4b27a8; text-decoration-color: #9d7ec2; }
  .diagnostic-form { display: grid; min-width: 0; padding: clamp(1.5rem, 3.5vw, 3.3rem); border: 1px solid #d3c3e5; border-top: 3px solid #7d3cff; border-radius: .45rem; background: #fff; box-shadow: 0 24px 70px #44246c12; }
  .form-availability{margin:0 0 1.5rem;padding:1rem 1.2rem;border-left:3px solid #8551be;color:#4c3564;background:#f4ecff;font-size:.86rem;line-height:1.6}.form-availability a{color:#4b27a8;font-weight:700}
  .form-stage { min-width: 0; padding-block: 2.6rem; border-top: 1px solid #e4dce9; }
  .form-stage:first-of-type { padding-top: .5rem; border-top: 0; }
  .form-stage--last { padding-bottom: .25rem; }
  .form-stage__heading { display: grid; grid-template-columns: 2.35rem minmax(0, 1fr); align-items: start; gap: .85rem; margin-bottom: 1.65rem; }
  .form-stage__number { display: grid; width: 2.15rem; height: 2.15rem; place-items: center; border: 1px solid #a484d1; border-radius: 50%; color: #5e2da6; background: #f4edff; font-size: .69rem; font-weight: 700; font-variant-numeric: tabular-nums; }
  .form-stage__heading h3 { margin: -.25rem 0 .3rem; color: #241334; font-family: var(--font-display); font-size: clamp(1.55rem, 2vw, 2rem); font-weight: 400; letter-spacing: -.045em; line-height: 1.2; }
  .form-stage__heading p { margin: 0; color: #756584; font-size: .82rem; line-height: 1.5; }
  .form-stage__body { display: grid; gap: 1.35rem; padding-left: 3.2rem; }
  .form-row--split { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
  .field { display: grid; align-content: start; gap: .43rem; min-width: 0; }
  .field-help { margin: 0; color: #6d5d7b; font-size: .76rem; line-height: 1.55; }
  label, legend { color: #352347; font-size: .83rem; font-weight: 650; line-height: 1.45; }
  label span { margin-left: .3rem; color: #756584; font-size: .72rem; font-weight: 400; }
  input:not([type='radio']):not([type='hidden']), textarea { width: 100%; min-width: 0; min-height: 3.25rem; padding: .85rem 1rem; border: 1px solid #cfc4d9; border-radius: .35rem; color: #241334; background: #fcfaff; font-size: .94rem; transition: border-color var(--duration-fast) var(--ease-standard), background-color var(--duration-fast) var(--ease-standard), box-shadow var(--duration-fast) var(--ease-standard); }
  input::placeholder, textarea::placeholder { color: #8d809a; }
  textarea { min-height: 8rem; resize: vertical; line-height: 1.6; }
  input:not([type='radio']):hover, textarea:hover { border-color: #a17bc5; }
  input:focus-visible, textarea:focus-visible { border-color: #6d32b6; outline: 2px solid #6d32b6; outline-offset: 2px; background: #fff; box-shadow: 0 0 0 4px #a47adb15; }
  input[aria-invalid='true'], textarea[aria-invalid='true'] { border-color: #ad334f; }
  small { color: #a02540; font-size: .75rem; line-height: 1.5; }
  small:empty { display: none; }
  .preference-field { display: flex; flex-wrap: wrap; gap: .6rem 1rem; margin: 0; padding: 0; border: 0; }
  .preference-field legend { width: 100%; margin-bottom: .8rem; padding: 0; }
  .preference-field label { display: inline-flex; min-height: 2.75rem; align-items: center; gap: .6rem; padding: .4rem .95rem; border: 1px solid #d2c4e1; border-radius: 99px; background: #fbf8ff; cursor: pointer; font-weight: 500; }
  .preference-field label:has(input:checked) { border-color: #8153b9; color: #502481; background: #f1e8ff; }
  .preference-field input { width: 1rem; min-height: auto; margin: 0; accent-color: #6d32b6; }
  .preference-field small { width: 100%; }
  .cf-turnstile { min-width: 0; max-width: 100%; overflow: hidden; }
  .trap { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .form-submit { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: 1.25rem; padding-top: 1.5rem; border-top: 1px solid #e4dce9; }
  .form-submit :global(.button) { flex-shrink: 0; }
  .form-submit p { max-width: 46ch; margin: 0; color: #685776; font-size: .72rem; line-height: 1.7; }
  .form-submit a { color: #4b27a8; text-decoration-color: #9d7ec2; }
  .form-status { margin-bottom: 1.5rem; padding: 1rem 1.25rem; border: 1px solid #da9bad; border-radius: .4rem; color: #772642; background: #fff2f5; line-height: 1.6; }
  .form-status[data-state='success'] { margin: 0; border-color: #9bc9ad; color: #1f5836; background: #edf9f0; }
  .form-status[data-state='fatal'] { border-color: #ad334f; }
  [hidden] { display: none !important; }
  @media (max-width: 70rem) { .contact-grid { grid-template-columns: 1fr; gap: 2.5rem; } .contact-intro { position: static; padding-top: 0; } .contact-intro h2 { max-width: 16ch; } .contact-intro > p:not(.contact-index) { max-width: 70ch; } .contact-intro > p:last-child { max-width: 70ch; } }
  @media (max-width: 45rem) { .form-row--split { grid-template-columns: 1fr; } .form-stage__body { padding-left: 0; } .form-submit { grid-template-columns: 1fr; align-items: start; } .form-submit :global(.button) { width: 100%; } }
  @media (max-width: 30rem) { .contact-section { padding-block: 4rem; } .contact-intro h2 { font-size: clamp(2.8rem, 12vw, 3.6rem); } .diagnostic-form { padding: 1.25rem; } .form-stage { padding-block: 2rem; } .form-stage__heading { gap: .65rem; } .preference-field label { flex: 1 1 auto; justify-content: center; } }
  @media (prefers-reduced-motion: reduce) { input, textarea { transition: none; } }
</style>
