<script>
  const elements = document.querySelectorAll<HTMLElement>('[data-ambient]');
  const visible = new Set<HTMLElement>();
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const update = () => elements.forEach(el => { el.dataset.inView = String(visible.has(el) && !document.hidden && !reduced.matches); });
  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => entry.isIntersecting ? visible.add(entry.target as HTMLElement) : visible.delete(entry.target as HTMLElement));
    update();
  }, { rootMargin: '40px' });
  elements.forEach(el => observer.observe(el));
  document.addEventListener('visibilitychange', update);
  reduced.addEventListener('change', update);
</script>
