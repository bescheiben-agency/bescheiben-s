---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SectionHeading from '../components/SectionHeading.astro';

const principles = [
  {
    number: '01',
    title: 'O problema antes do formato',
    body: 'A leitura começa pelo contexto e pelas relações que produzem a tensão — não por uma solução previamente empacotada.',
  },
  {
    number: '02',
    title: 'Clareza sem simplificação vazia',
    body: 'Complexidade pode ser organizada sem fingir que decisões relevantes cabem em uma fórmula universal.',
  },
  {
    number: '03',
    title: 'Direção próxima da execução',
    body: 'Critérios estratégicos precisam sobreviver ao uso, às restrições e às respostas que surgem quando a escolha entra em movimento.',
  },
  {
    number: '04',
    title: 'Evidência com contexto',
    body: 'Sinais ganham valor quando ajudam a compreender uma decisão, seus limites e o próximo aprendizado necessário.',
  },
];

const commitments = [
  ['Tornar critérios visíveis', 'Explicar como uma escolha foi construída e quais consequências ela assume.'],
  ['Nomear limites', 'Distinguir hipótese, evidência e decisão sem transformar possibilidade em promessa.'],
  ['Preservar coerência', 'Conectar posicionamento, marca, aquisição e conversão em vez de otimizar frentes isoladas.'],
  ['Respeitar o contexto', 'Evitar urgência artificial, fórmulas prontas e simplificações que escondem trade-offs.'],
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'Bescheiben',
    description: 'Princípios e compromissos da Bescheiben para transformar estratégia em direção, movimento e aprendizado.',
    url: 'https://bescheiben.com.br/bescheiben',
    inLanguage: 'pt-BR',
    about: { '@type': 'Organization', name: 'Bescheiben' },
  },
];
---

<BaseLayout
  title="Bescheiben — princípios e visão"
  description="Conheça os princípios que orientam como a Bescheiben lê problemas, estrutura decisões e conecta estratégia à execução."
  schema={schema}
>
  <Header />

  <main id="conteudo">
    <section class="about-hero section-shell">
      <div class="container about-hero__grid">
        <div>
          
          <h1>Estratégia é coerência em movimento.</h1>
          <p class="lead">A Bescheiben existe para organizar decisões que precisam atravessar posicionamento, marca, aquisição e conversão sem perder a direção.</p>
          <Button href="/metodo">Conhecer o método</Button>
        </div>

        <div class="about-symbol" aria-hidden="true">
          <div class="about-symbol__line"></div>
          <img src="/brand/symbol-purple.svg" width="184" height="184" alt="" />
          <span>Direção</span><span>Movimento</span><span>Aprendizado</span>
        </div>
      </div>
    </section>

    <section class="manifesto section-shell surface-inverse">
      <div class="container manifesto__grid">
        <div>
          <h2>Equilíbrio é a base de tudo.</h2>
          <p>Entre ambição e capacidade. Entre profundidade e clareza. Entre uma direção firme e a abertura necessária para aprender.</p>
          <p>Estratégia, para a Bescheiben, não é uma camada distante da execução. É o sistema de escolhas que permite reconhecer o que importa, tornar essa diferença visível, criar movimento e interpretar a resposta.</p>
          <p>Quando essas partes se afastam, o crescimento perde legibilidade. Quando se relacionam, cada ação pode contribuir para uma compreensão maior do negócio e de seu próximo passo.</p>
        </div>
      </div>
    </section>

    <section class="section-shell">
      <div class="container">
        <SectionHeading
          label="Princípios de trabalho"
          title="Como escolhemos compreender e agir."
          body="Princípios não substituem o método. Eles delimitam a qualidade de raciocínio que o método precisa preservar."
        />
        <ol class="principle-list">
          {principles.map((principle) => (
            <li>
              
              <h3>{principle.title}</h3>
              <p>{principle.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section-shell surface-subtle">
      <div class="container posture-layout">
        <SectionHeading
          label="Postura"
          title="Autoridade não precisa esconder o processo."
          body="Na ausência de atalhos de credibilidade, a qualidade precisa aparecer na forma de estruturar perguntas, escolhas e limites."
        />
        <div class="posture-statement">
          <p>A Bescheiben não usa complexidade para parecer distante.</p>
          <strong>Usa estrutura para tornar decisões complexas discutíveis.</strong>
        </div>
      </div>
    </section>

    <section class="section-shell">
      <div class="container commitment-layout">
        <SectionHeading
          label="Compromissos"
          title="O que deve permanecer verdadeiro durante o trabalho."
          body="Compromissos de processo e comunicação que independem do formato específico de atuação."
        />
        <dl class="commitment-list">
          {commitments.map(([term, description]) => (
            <div><dt>{term}</dt><dd>{description}</dd></div>
          ))}
        </dl>
      </div>
    </section>

    <section class="boundary section-shell surface-inverse">
      <div class="container boundary__grid">
        <div>
          
          <h2>Nem toda atividade é avanço estratégico.</h2>
        </div>
        <ul>
          <li>Não recomendar um formato antes de compreender o problema.</li>
          <li>Não transformar hipótese em certeza para tornar a proposta mais convincente.</li>
          <li>Não otimizar uma frente de modo que prejudique a coerência do sistema.</li>
          <li>Não medir qualidade apenas pela quantidade de entregáveis ou ações.</li>
        </ul>
      </div>
    </section>

    <section class="about-next section-shell">
      <div class="container about-next__inner">
        <img src="/brand/symbol-purple.svg" width="72" height="72" alt="" aria-hidden="true" />
        <div>
          
          <h2>Veja como os princípios atravessam o método.</h2>
          <p>Diagnosticar, direcionar, ativar e evoluir formam um percurso contínuo de decisão.</p>
        </div>
        <Button href="/metodo">Conhecer o método</Button>
      </div>
      <div class="container diagnostic-link">
        <p>Já existe uma questão concreta?</p>
        <a class="text-link" href="/diagnostico">Solicitar diagnóstico estratégico</a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>



